{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dony Invoice",
  "version": "1.0.0",
  "identifier": "id.ezcode.dony-invoice",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --force",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Dony Invoice",
        "width": 1600,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:dony_invoice.db",
        "sqlite:nadhi_invoice.db"
      ]
    }
  }
}